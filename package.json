{
  "name": "@dhawalhost/wardseal-ui-kit",
  "version": "0.2.1",
  "description": "WardSeal Brand UI Component Library — React + Tailwind. Source of truth for the WardSeal design system across all apps.",
  "keywords": [
    "wardseal",
    "ui",
    "components",
    "react",
    "tailwind",
    "design-system"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhawalhost/wardseal-ui-kit.git"
  },
  "homepage": "https://github.com/dhawalhost/wardseal-ui-kit",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles/global.css",
    "./src/styles/tokens.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": {
      "default": "./src/styles/global.css"
    },
    "./tokens.css": {
      "default": "./src/styles/tokens.css"
    },
    "./tailwind-preset": {
      "types": "./src/tailwind-preset.ts",
      "default": "./src/tailwind-preset.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "src/tailwind-preset.ts",
    "README.md",
    "LAYOUT.md",
    "THEMES.md",
    "MAINTENANCE.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && cp src/styles/tokens.css dist/tokens.css && cp src/styles/global.css dist/global.css",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sync:web-ui": "rsync -a --delete --exclude '*.stories.tsx' --exclude '.DS_Store' src/ ../wardseal/web/ui/src/ && cp src/styles/tokens.css ../wardseal/web/ui/src/styles/ && cp src/styles/global.css ../wardseal/web/ui/src/styles/ && cp src/tailwind-preset.ts ../wardseal/web/ui/src/"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.1.8",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3.2.4",
    "@storybook/addon-essentials": "8.5.8",
    "@storybook/addon-interactions": "8.5.8",
    "@storybook/addon-onboarding": "8.5.8",
    "@storybook/blocks": "8.5.8",
    "@storybook/react": "8.5.8",
    "@storybook/react-vite": "8.5.8",
    "@storybook/test": "8.5.8",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^6.3.0"
  }
}
